[Unit]
Description=Pocket Move — breathe, sit, notice
After=network-online.target
Wants=network-online.target

[Service]
User=pocket-move
Group=pocket-move
ExecStart=/usr/local/bin/pocket-move
Environment=DATA_DIR=/var/lib/pocket-move
Environment=PORT=8080
Environment=BASE_URL=https://move.example.com
Environment=SECURE_COOKIES=true
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pocket-move
PrivateTmp=true

[Install]
WantedBy=multi-user.target
